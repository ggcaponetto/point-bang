{
  "name": "lightgun-poc",
  "version": "0.10.1",
  "private": true,
  "description": "Phone WebXR -> PC cursor proof of concept",
  "type": "module",
  "workspaces": [
    "editor",
    "site"
  ],
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "bin": {
    "point-bang": "cli.ts"
  },
  "scripts": {
    "start": "node cli.ts serve",
    "start:adb": "node cli.ts serve --mode adb",
    "start:wifi": "node cli.ts serve --mode wifi",
    "ip": "node cli.ts ip",
    "wifi": "node cli.ts wifi",
    "monitors": "node cli.ts monitors",
    "check": "node cli.ts check",
    "build:sea": "node build/sea.mjs",
    "smoke": "node build/smoke.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "loc": "node build/loc.mjs",
    "build:editor": "npm run -w editor build",
    "validate": "npm run format:check && npm run typecheck && npm run knip && npm run loc && npm test && npm run -w editor validate",
    "docs:api": "typedoc",
    "docs:assets": "node build/pages.mjs",
    "docs:site": "node build/site.mjs",
    "docs:dev": "npm run docs:assets && npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:assets && npm run docs:site && npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "release": "node build/release.mjs",
    "start:tunnel": "node cli.ts serve --tunnel ngrok",
    "tunnel": "node cli.ts tunnel"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@nut-tree-fork/libnut-darwin": "^2.7.5",
    "@nut-tree-fork/libnut-linux": "^2.7.5",
    "@nut-tree-fork/libnut-win32": "^2.7.5",
    "koffi": "^3.1.4",
    "qrcode-terminal": "^0.12.0",
    "werift": "0.24.4",
    "ws": "^8.17.0",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.8.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.0"
  }
}
