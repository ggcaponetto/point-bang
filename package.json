{
  "name": "lightgun-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Phone WebXR -> PC cursor proof of concept",
  "type": "module",
  "scripts": {
    "start": "node server.ts",
    "start:adb": "node server.ts --mode=adb",
    "start:wifi": "node server.ts --mode=wifi",
    "ip": "node ip.ts",
    "wifi": "node wifi.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "validate": "npm run format:check && npm run typecheck && npm run knip && npm test",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "husky": "^9.1.7",
    "knip": "^6.32.1",
    "prettier": "^3.9.6",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.8.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.0"
  }
}
