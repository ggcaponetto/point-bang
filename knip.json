{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreWorkspaces": ["site"],
  "workspaces": {
    ".": {
      "entry": ["public/math.js", "public/transport.js", "build/*.mjs"],
      "project": ["**/*.ts", "build/*.mjs"],
      "ignoreDependencies": ["@nut-tree-fork/libnut-linux", "@nut-tree-fork/libnut-win32"]
    },
    "editor": {
      "entry": ["src/main.tsx", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "*.ts"]
    }
  }
}
