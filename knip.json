{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreWorkspaces": ["site"],
  "workspaces": {
    ".": {
      "entry": [
        "public/math.js",
        "public/transport.js",
        "public/editor.js",
        "public/editor-i18n.js",
        "build/*.mjs"
      ],
      "project": ["**/*.ts", "build/*.mjs"],
      "ignoreDependencies": ["@nut-tree-fork/libnut-linux", "@nut-tree-fork/libnut-win32"]
    }
  }
}
